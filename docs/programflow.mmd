    classDef ikStage fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#f8fafc;
    classDef stabStage fill:#134e4a,stroke:#14b8a6,stroke-width:2px,color:#f8fafc;
    classDef normStage fill:#365314,stroke:#84cc16,stroke-width:2px,color:#f8fafc;
    classDef exportStage fill:#701a75,stroke:#ec4899,stroke-width:2px,color:#f8fafc;
    classDef decisionNode fill:#7c2d12,stroke:#f97316,stroke-width:2px,color:#f8fafc;

    class SRC_BODY,SRC_FACE,CAP_SESSION,FRAME_RAW ingestStage;
    class PYR_BODY,PYR_NATIVE preprocStage;
    class DET_BODY,PTS_BODY_RAW,FOREARM_VEC,CROP_HAND,DET_HAND,PTS_HAND_RAW inferStage;
    class BYTETRACK,RESOLVE_STEAL,SOLVER_INGEST trackStage;
    class BODY_IK,B_LEN,B_HINGE,HAND_IK,H_TENDON,H_CLMAP,H_HINGE,H_LANE,ANAT_RIG ikStage;
    class FLT_SMOOTH,ROT_SLERP,FOOT_LOCK stabStage;
    class COORD_TRANS,SCALE_NORM,GROUND_ALIGN normStage;
    class EXP_JSON,BLENDER_PY,EXP_FBX,EXP_UDP exportStage;
